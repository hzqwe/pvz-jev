# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 运行产物（截图 / 决策日志 / 复盘报告），本地保留、不入库 ----
# 原始对局日志是复盘证据，不是可以随意删除的缓存。
out/

# ---- 第三方参考源码 ----
# refs/ 里是 pvztoolkit (GPL-3.0) 与 PVZ_Helper 的源码副本，
# 只用来核对内存偏移，不是本项目的工作成果，因此不入库。
# 需要时请从上游获取：
#   https://github.com/lmintlcx/pvztoolkit
#   https://github.com/zhumxiang/PVZ_Helper
refs/

# ---- 本地快照备份 ----
_backups/
.worktrees/

# ---- 本地凭据与环境（示例配置可以提交）----
.env
.env.*
!.env.example
!.env.sample
jev_api_key

